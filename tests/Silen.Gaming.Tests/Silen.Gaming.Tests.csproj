<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../../src/Silen.Gaming/Silen.Gaming.csproj" />
    <ProjectReference Include="FakePresentMon/FakePresentMon.csproj" ReferenceOutputAssembly="false" />
    <None Include="Fixtures/**/*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/PresentMon/PresentMon.exe" Link="tools/PresentMon/PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="FakePresentMon/**/*.cs" />
  </ItemGroup>
  <Target Name="CopyFakeCaptureExecutable" AfterTargets="Build">
    <ItemGroup><FakeCaptureFiles Include="$(MSBuildProjectDirectory)/FakePresentMon/bin/$(Configuration)/net10.0/*" /></ItemGroup>
    <Copy SourceFiles="@(FakeCaptureFiles)" DestinationFolder="$(OutDir)FakePresentMon" SkipUnchangedFiles="true" />
  </Target>
</Project>
