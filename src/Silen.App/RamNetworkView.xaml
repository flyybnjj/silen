<UserControl x:Class="Silen.App.RamNetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Silen.App" xmlns:system="clr-namespace:System;assembly=System.Runtime">
  <UserControl.Resources>
    <Style x:Key="RamSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}"><Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="30" /><Setter Property="Margin" Value="0" /></Style>
    <Style x:Key="RamDnsCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="None" /><Setter Property="LineHeight" Value="20" /></Style>
    <Style x:Key="RamReading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="32" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" /><Setter Property="Margin" Value="0,3,0,3" /></Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="RamScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20"><StackPanel>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><TextBlock Text="Memoria del equipo" Style="{StaticResource RamSectionTitle}" /><TextBlock Text="{Binding MeasurementTime}" Style="{StaticResource Small}" Margin="0,3,0,0" /></StackPanel>
        <Button Grid.Column="1" Content="Actualizar detalles" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" FontWeight="Normal" VerticalAlignment="Top" AutomationProperties.HelpText="Lee procesos y paginación. No modifica Windows." />
      </Grid>
      <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}}" AutomationProperties.Name="Leyendo detalles de memoria" />
      <local:SummaryErrorNotice Message="{Binding MemoryError}" Margin="0,0,0,12" Visibility="{Binding HasMemoryError, Converter={StaticResource Visible}}" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="RAM en uso / total" Style="{StaticResource Small}" /><TextBlock Text="{Binding PhysicalMemoryValue}" Style="{StaticResource RamReading}" /><TextBlock Text="{Binding AvailableMemory}" Style="{StaticResource Small}" /></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Memoria comprometida / límite" Style="{StaticResource Small}" /><TextBlock Text="{Binding CommittedMemoryValue}" Style="{StaticResource RamReading}" /><TextBlock Text="{Binding PagefileState}" Style="{StaticResource Small}" /></StackPanel>
      </Grid>
      <Expander x:Name="MemoryInterpretation" Header="{Binding AssessmentLabel}" Margin="0,12,0,0"><StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,4">
        <TextBlock Text="{Binding Assessment.Message}" LineHeight="24" />
        <TextBlock Text="Los ajustes de segundo plano están en Optimizar PC. Esta vista no vacía cachés ni cierra aplicaciones." Style="{StaticResource Small}" Margin="0,8,0,0" />
      </StackPanel></Expander>
      <Expander Header="Procesos por memoria" Margin="0,4,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding MemoryStatus}" Style="{StaticResource Small}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,10" /><DataGrid ItemsSource="{Binding Processes}" MaxHeight="260" Visibility="{Binding HasProcesses, Converter={StaticResource Visible}}" AutomationProperties.Name="Procesos observados por memoria"><DataGrid.Columns><DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="90" /><DataGridTextColumn Header="Memoria MB" Binding="{Binding MemoryMb, StringFormat=N1}" Width="140" /></DataGrid.Columns></DataGrid></StackPanel></Expander>
    </StackPanel></Border>
    <StackPanel>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Respuesta DNS" Style="{StaticResource RamSectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Grid.Column="1" Content="Medir DNS" Command="{Binding MeasureCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.HelpText="Envía consultas DNS a los servidores comparados. No cambia tu configuración ni mide el ping de juegos." />
      </Grid>
      <TextBlock Text="Tres consultas por servidor, desde tu conexión." />
      <TextBlock Text="No cambia tus DNS ni mide el ping de juegos." Style="{StaticResource Small}" Margin="0,4,0,16" />
      <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsMeasuring, Converter={StaticResource Visible}}" Margin="0,0,0,12" AutomationProperties.Name="Midiendo respuestas DNS" />
      <TextBlock Text="{Binding DnsEmptyMessage}" Style="{StaticResource MutedText}" Visibility="{Binding HasDnsRows, Converter={StaticResource Visible}, ConverterParameter=inverse}" Margin="0,0,0,12" MaxWidth="620" HorizontalAlignment="Left" />
      <DataGrid ItemsSource="{Binding DnsRows}" RowHeight="{x:Static system:Double.NaN}" MinRowHeight="42" MaxHeight="360" Visibility="{Binding HasDnsRows, Converter={StaticResource Visible}}" AutomationProperties.Name="Resultados DNS de consultas reales"><DataGrid.Columns><DataGridTextColumn Header="Servidor" Binding="{Binding Name}" Width="*" MinWidth="140" /><DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="155" /><DataGridTextColumn Header="Mediana" Binding="{Binding Median}" Width="115" ElementStyle="{StaticResource RamDnsCell}" /><DataGridTextColumn Header="Última" Binding="{Binding Last}" Width="100" ElementStyle="{StaticResource RamDnsCell}" /><DataGridTextColumn Header="Pruebas" Binding="{Binding Progress}" Width="120" /></DataGrid.Columns></DataGrid>
      <TextBlock Text="{Binding DnsStatus}" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasDnsRows, Converter={StaticResource Visible}}" />
      <local:SummaryErrorNotice Message="{Binding DnsError}" Margin="0,12,0,0" Visibility="{Binding HasDnsError, Converter={StaticResource Visible}}" />
      <Expander Header="Qué se mide y qué no" Margin="0,16,0,0"><StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,10,0,0">
        <TextBlock Text="Se comparan los DNS configurados, Cloudflare, Google y Quad9 mediante consultas DNS convencionales a tres dominios públicos por servidor. Cada consulta tiene un tiempo límite y su respuesta se comprueba." LineHeight="24" />
        <TextBlock Text="La mediana resume esas consultas; Última muestra el intento más reciente. Una consulta DNS más rápida puede agilizar la resolución de nombres, pero no garantiza menor latencia con el servidor de un juego. No se cambian servidores ni se vacían cachés." LineHeight="24" Margin="0,10,0,0" />
      </StackPanel></Expander>
    </StackPanel>
  </StackPanel></ScrollViewer>
</UserControl>
