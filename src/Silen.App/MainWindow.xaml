<Window x:Class="Silen.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Silen.App" Style="{StaticResource {x:Type Window}}" Title="Silen" Icon="Assets/Silen.ico" Width="1240" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="DetailSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
      <Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="30" /><Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="DetailSection" TargetType="Border" BasedOn="{StaticResource Surface}">
      <Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Roles locales de Resumen: no alteran tipografía ni densidad de otras vistas. -->
    <Style x:Key="SummarySectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
      <Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="30" /><Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="SummaryMetric" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
      <Setter Property="FontSize" Value="30" /><Setter Property="LineHeight" Value="38" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0,4,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Muted}" /></DataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsScanning}" Value="True" /><Condition Binding="{Binding HasSummarySamples}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Normal" /></MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SummaryTrace" TargetType="local:ResourceTrace">
      <Setter Property="ShowGrid" Value="False" /><Setter Property="Height" Value="28" /><Setter Property="Margin" Value="0,8,0,8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="0,4,0,4" /></DataTrigger>
        <DataTrigger Binding="{Binding ShowSummaryTraces}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SummaryPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Style.Triggers><Trigger Property="ToolTip" Value=""><Setter Property="ToolTipService.IsEnabled" Value="False" /></Trigger></Style.Triggers>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
          <Grid><Border x:Name="HoverLayer" Background="{DynamicResource Text}" Opacity="0" CornerRadius="{StaticResource InnerControlRadius}" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Style>
              <Style TargetType="AccessText"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Style>
            </ContentPresenter.Resources></ContentPresenter>
          </Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.04" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.1" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Raised}" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SummaryScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}" />
    <Style x:Key="SummaryMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" />
    </Style>
    <DataTemplate x:Key="SummaryRecoveryTemplate">
      <StackPanel Visibility="{Binding HasBatch, Converter={StaticResource Visible}}" Margin="0,0,0,16">
        <TextBlock Text="Recuperación" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="{Binding PointStatus}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasPointError}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <local:SummaryErrorNotice Message="{Binding PointStatus}" Visibility="{Binding HasPointError, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding UndoStatus}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding HasUndoError}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <local:SummaryErrorNotice Message="{Binding UndoStatus}" Margin="0,8,0,0" Visibility="{Binding HasUndoError, Converter={StaticResource Visible}}" />
        <Button Content="Abrir Protección del sistema" Command="{Binding OpenProtectionCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding CanOpenProtection, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="PcOptimizationTemplate">
      <StackPanel>
        <TextBlock Text="Elige los ajustes. Nada se aplica hasta que revises y confirmes la selección." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
        <TextBlock Text="Cada ajuste conserva su estado anterior." Style="{StaticResource Small}" Margin="0,0,0,12" Visibility="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}, ConverterParameter=inverse}" />
        <StackPanel Visibility="{Binding IsOptimizing, Converter={StaticResource Visible}}" Margin="0,0,0,12"><TextBlock Text="{Binding ProgressTitle}" Style="{StaticResource Small}" /><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsPreparing}" Height="5" Margin="0,7,0,7" AutomationProperties.Name="Progreso de optimización del PC" /><TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource Small}" /></StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="{Binding HasStatus, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding HasActionError}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <local:SummaryErrorNotice Message="{Binding Status}" Margin="0,0,0,12"><local:SummaryErrorNotice.Style><Style TargetType="local:SummaryErrorNotice"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasStatus}" Value="True" /><Condition Binding="{Binding HasActionError}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></local:SummaryErrorNotice.Style></local:SummaryErrorNotice>
        <ContentControl Content="{Binding DataContext.Recovery, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{StaticResource SummaryRecoveryTemplate}" Focusable="False" IsTabStop="False" />
        <Expander Header="Resultado de cada ajuste" IsExpanded="False" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource Visible}}"><ItemsControl ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" /><TextBlock Text="{Binding Message}" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
        <Expander Header="Elegir juego o aplicación" Margin="0,14,0,14" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}, ConverterParameter=inverse}"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="Elige un producto para configurar su GPU y temporizador automático. Los controles de teclado y ratón que se ofrecen cambian la entrada de Windows hasta restaurarlos." Style="{StaticResource Small}" Margin="0,0,0,10" />
          <WrapPanel Margin="0,0,0,10"><Button Content="Buscar productos instalados" Command="{Binding FindProductsCommand}" Margin="0,0,8,0" /><Button Content="Elegir .exe manualmente" Command="{Binding ChooseExecutableCommand}" /></WrapPanel>
          <Label Content="Buscar por nombre o editor" Padding="0,0,0,4" Foreground="{DynamicResource Text}" /><TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar juego o aplicación" Margin="0,0,0,10" />
          <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" AutomationProperties.Name="Producto instalado elegido" Margin="0,0,0,10" />
          <Button Content="Localizar ejecutables" Command="{Binding LocateProductCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
          <ComboBox ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable}" AutomationProperties.Name="Ejecutable principal del producto" Margin="0,0,0,10" />
          <TextBlock Text="{Binding ProductStatus}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding ApplicationTimerStatus}" Style="{StaticResource Small}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
          <Button Content="Desactivar temporizador de esta app" Command="{Binding DisableTimerCommand}" Visibility="{Binding HasTimerProfile, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel></Expander>
        <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource Visible}}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
          <WrapPanel Margin="0,0,0,12"><Button Content="Recomendados" Command="{Binding RecommendedCommand}" Style="{StaticResource QuietButton}" BorderThickness="0" Padding="8,8" FontWeight="Normal" Margin="0,0,8,0" /><Button Content="Quitar selección" Command="{Binding ClearSelectionCommand}" Style="{StaticResource QuietButton}" BorderThickness="0" Padding="8,8" FontWeight="Normal" Margin="0,0,8,0" /><Button Content="Actualizar disponibilidad" Command="{Binding PrepareCommand}" Style="{StaticResource QuietButton}" BorderThickness="0" Padding="8,8" FontWeight="Normal" /></WrapPanel>
          <StackPanel Visibility="{Binding DataContext.CanRequestOptimizationElevation, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"><Button Content="Abrir Silen como administrador" Command="{Binding DataContext.OpenOptimizationElevatedCommand, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding NeedsAdministrator, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,12" ToolTip="Solicita permiso a Windows y abre otra ventana. No aplica ajustes automáticamente." /></StackPanel>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Label Content="Buscar ajuste" /><TextBox Text="{Binding OptionSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar ajuste del PC" /></StackPanel><StackPanel Grid.Column="1"><Label Content="Categoría" /><ComboBox ItemsSource="{Binding OptionCategories}" SelectedItem="{Binding OptionCategory}" /></StackPanel></Grid><TextBlock Text="No hay ajustes que coincidan con la búsqueda." Style="{StaticResource Small}" Margin="0,0,0,16" Visibility="{Binding HasVisibleOptions, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><ItemsControl ItemsSource="{Binding VisibleOptions}" AutomationProperties.Name="Selección de ajustes del PC"><ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Option.Available}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Option.Title}">
                  <StackPanel Margin="8,0,10,0">
                    <TextBlock Text="{Binding Option.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Option.Description}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Option.Category}" Style="{StaticResource Small}" MaxWidth="140" Margin="0,0,12,0" /><TextBlock Grid.Column="1" Text="{Binding Option.Status}" Style="{StaticResource Small}" /></Grid>
                    <TextBlock Text="{Binding Option.ActivationHint}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="OptimizationFailureTemplate"><ItemsControl ItemsSource="{Binding FailedSteps}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Message}" Style="{StaticResource Small}" Foreground="{DynamicResource ErrorText}" Margin="0,4,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate>
    <DataTemplate x:Key="OptimizationRecoveryTemplate"><StackPanel>
      <ListBox ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" MaxHeight="220" AutomationProperties.Name="Ajustes guardados para restaurar"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Button Content="Cargar respaldos del sistema" Command="{Binding LoadSystemBackupsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" /><Button Content="Restaurar ajuste" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel></DataTemplate>
    <DataTemplate x:Key="SummaryOptimizationLaunchTemplate"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0"><TextBlock Text="Optimización" Style="{StaticResource SummarySectionTitle}" /><TextBlock Text="Revisa qué cambiará y confirma tu selección." Style="{StaticResource MutedText}" HorizontalAlignment="Left" MaxWidth="520" Margin="0,6,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" MaxWidth="220"><Button Content="Optimizar PC" Command="{Binding PrepareCommand}" AutomationProperties.Name="Preparar optimización del PC sin aplicar cambios" Style="{StaticResource SummaryPrimaryButton}" ToolTip="{Binding DataContext.DiagnosticApplyNotice, RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" /><TextBlock Text="{Binding DataContext.DiagnosticApplyNotice, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Small}" TextAlignment="Right" Margin="0,6,0,0" Visibility="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" /></StackPanel>
      </Grid>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Foreground="{DynamicResource Text}" Margin="0,12,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
      <local:SummaryErrorNotice Message="{Binding Status}" Margin="0,12,0,0" Visibility="{Binding HasActionError, Converter={StaticResource Visible}}" />
    </StackPanel></DataTemplate>
  </Window.Resources>
  <Grid x:Name="MotionRoot" Background="{DynamicResource Ink}" ClipToBounds="True">
    <local:SilenRibbon x:Name="RibbonArtwork" IsHitTestVisible="False" Focusable="False" />
    <Border x:Name="ReadabilityVeil" Background="{DynamicResource Ink}" IsHitTestVisible="False" />
    <Grid x:Name="ApplicationChrome" Background="Transparent"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ShowStartupLoading}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger><DataTrigger Binding="{Binding IsOptimizationDialogOpen}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Button Command="{Binding NavigateCommand}" CommandParameter="3" Style="{x:Null}" FocusVisualStyle="{StaticResource Focus}" Background="Transparent" BorderThickness="0" Padding="0" Width="108" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,28,0,0" ToolTip="Ajustes de Silen" AutomationProperties.Name="Abrir ajustes de Silen"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter /></ControlTemplate></Button.Template><Image Source="{DynamicResource SilenLogo}" Width="108" Height="44" Stretch="Uniform" AutomationProperties.Name="silen" /></Button>
        <TextBlock Text="Ajustes" Style="{StaticResource Small}" Margin="28,76,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/><ListBox Grid.Row="1" Margin="16,44,16,20" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.Name="Vistas del diagnóstico" KeyboardNavigation.DirectionalNavigation="Contained" HorizontalAlignment="Stretch" VerticalAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBoxItem><TextBlock Text="Resumen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
          <ListBoxItem><TextBlock Text="RAM y red" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
          <ListBoxItem><TextBlock Text="Drivers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
          <ListBoxItem Visibility="Collapsed"><TextBlock Text="Ajustes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>

          <ListBoxItem><TextBlock Text="Historial" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
          <ListBoxItem><TextBlock Text="Bloom" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></ListBoxItem>
        </ListBox>
      </Grid>
    </Border>
    <Grid Grid.Column="1" MaxWidth="1120"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="36,24,36,20" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Margin" Value="36,24,36,20" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedPage}" Value="0" /><Condition Binding="{Binding ShowStart}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
        <StackPanel>
          <TextBlock Text="{Binding PageTitle}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Heading}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="FontSize" Value="30" /><Setter Property="LineHeight" Value="40" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{Binding PageDescription}" Margin="0,8,20,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{Binding Observation}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="3"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="4"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding SelectedPage}" Value="5"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,4,0,0"><Button Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0" /></StackPanel>
      </Grid>
      <local:SummaryErrorNotice x:Name="SummaryErrorPanel" Grid.Row="1" Message="{Binding Error}" DismissCommand="{Binding ClearErrorCommand}"><local:SummaryErrorNotice.Style><Style TargetType="local:SummaryErrorNotice"><Setter Property="Margin" Value="36,0,36,16" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowStart}" Value="True"><Setter Property="Margin" Value="36,24,36,16" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedPage}" Value="0" /><Condition Binding="{Binding HasError}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></local:SummaryErrorNotice.Style></local:SummaryErrorNotice>
      <local:SummaryErrorNotice Grid.Row="1" Message="{Binding Error}" DismissCommand="{Binding ClearErrorCommand}" Margin="36,0,36,16"><local:SummaryErrorNotice.Style><Style TargetType="{x:Type local:SummaryErrorNotice}"><Setter Property="Visibility" Value="{Binding HasError, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></local:SummaryErrorNotice.Style></local:SummaryErrorNotice>
      <Border Grid.Row="2" Background="{DynamicResource Raised}" CornerRadius="6" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
        <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="16,13" /><Setter Property="Margin" Value="36,0,36,16" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Padding" Value="16,9" /><Setter Property="Margin" Value="36,0,36,8" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ScanStage}" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Text" Value="Analizando tu equipo" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="1" Text="{Binding ScanPercentLabel}" Style="{StaticResource Small}" Margin="14,0,0,0" /></Grid>
          <ProgressBar Value="{Binding ScanPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,8" AutomationProperties.Name="Progreso del análisis por pasos completados"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Height" Value="6" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Height" Value="3" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="Background" Value="{DynamicResource Line}" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
          <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Setter Property="Text" Value="{Binding ScanDetail}" /><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Text" Value="{Binding SummaryScanStep}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{Binding LiveSummary}" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
      </Border>
      <local:PageHost x:Name="Pages" Grid.Row="3" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="36,0,36,20">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" /></ControlTemplate></TabControl.Template>
        <TabItem Header="Resumen"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border x:Name="SummarySelectionBar" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,16" Visibility="{Binding PcOptimization.HasPreview, Converter={StaticResource Visible}}">
            <StackPanel>
              <Grid DataContext="{Binding PcOptimization}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" /><StackPanel Grid.Column="1" MaxWidth="220"><Button Content="Revisar selección" Command="{Binding PrepareCommand}" Style="{StaticResource SummaryPrimaryButton}" HorizontalAlignment="Right" /><TextBlock Text="{Binding DataContext.DiagnosticApplyNotice, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Small}" TextAlignment="Right" Margin="0,6,0,0" Visibility="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" /></StackPanel></Grid>
              <Grid DataContext="{Binding Recovery}" Visibility="{Binding HasBatch, Converter={StaticResource Visible}}" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding LastChangeLabel}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,16,0" /><Button Grid.Column="1" Content="Deshacer último cambio" Command="{Binding UndoCommand}" Style="{StaticResource QuietButton}" ToolTip="{Binding UndoStatus}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding UndoStatus}" /></Grid>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SummaryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SummaryScrollBar}" /></ScrollViewer.Resources>
          <StackPanel>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,20,0,24" Margin="0,0,0,24">
