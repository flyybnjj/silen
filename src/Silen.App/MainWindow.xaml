        </Grid></TabItem>
        <TabItem Header="Historial"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
          <DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="Actualizar historial" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource QuietButton}" /><TextBlock Text="Guardado en este equipo" ToolTip="{Binding HistoryLocationText}" Style="{StaticResource Small}" VerticalAlignment="Center" /></DockPanel>
          <Border Style="{StaticResource DetailSection}" Margin="0,0,0,24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Análisis guardados" Style="{StaticResource DetailSectionTitle}" /><ListBox Grid.Row="1" ItemsSource="{Binding Reports}" MaxHeight="240" SelectedItem="{Binding SelectedReport}" AutomationProperties.Name="Informes guardados"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding CapturedAt, StringFormat=dd/MM/yyyy HH:mm}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" /><TextBlock Text="{Binding CpuName}" Style="{StaticResource Small}" ToolTip="{Binding CpuName}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding FindingCount, StringFormat=Hallazgos: {0}}" Style="{StaticResource Small}" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="Tu próximo análisis aparecerá aquí. También se guardará si alguna fuente no responde." Style="{StaticResource MutedText}" Visibility="{Binding HasReports, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><Button Grid.Row="2" Content="Abrir análisis seleccionado" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Selecciona una observación en la lista" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="0,12,0,0" /></Grid></Border>
          <Border Style="{StaticResource DetailSection}" BorderThickness="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Guías abiertas" Style="{StaticResource DetailSectionTitle}" /><ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,14,0" /><TextBlock Text="{Binding At, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource Small}" /></WrapPanel><TextBlock Text="{Binding Outcome}" Style="{StaticResource Small}" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="1" Text="Cuando abras una guía, su fecha y resultado quedarán registrados aquí." Style="{StaticResource MutedText}" Visibility="{Binding HasActions, Converter={StaticResource Visible}, ConverterParameter=inverse}" /></Grid></Border>
          <Expander Header="Exportar el diagnóstico actual" Margin="0,0,0,24" Visibility="{Binding HasCompletedResult, Converter={StaticResource Visible}}"><StackPanel Margin="0,12,0,0"><TextBlock Text="Los informes contienen hardware y nombres de procesos. Revisa su contenido antes de compartirlos." Style="{StaticResource Small}" Margin="0,0,0,12" /><WrapPanel><Button Content="Exportar JSON" Command="{Binding ExportCommand}" CommandParameter="json" Margin="0,0,8,0" /><Button Content="Exportar Markdown" Command="{Binding ExportCommand}" CommandParameter="markdown" /></WrapPanel></StackPanel></Expander>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Bloom"><Grid DataContext="{Binding Bloom}" Background="{DynamicResource Panel}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Expander Header="Proveedor y modelo" Margin="0,0,0,12" AutomationProperties.Name="Configurar proveedor de Bloom"><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,8,0">
    <WrapPanel IsEnabled="{Binding CanInteract}"><StackPanel Margin="0,0,12,10"><Label Content="Proveedor" Target="{Binding ElementName=BloomProviderChoice}"/><ComboBox x:Name="BloomProviderChoice" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Width="130"/></StackPanel><StackPanel Margin="0,0,12,10"><Label Content="Modelo" Target="{Binding ElementName=BloomModelChoice}"/><ComboBox x:Name="BloomModelChoice" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="220"/></StackPanel><Button Content="Usar proveedor y modelo" Command="{Binding ConfigureCommand}" VerticalAlignment="Bottom" Margin="0,0,0,10"/></WrapPanel>
    <TextBlock Text="{Binding PrivacySummary}" Style="{StaticResource Small}" MaxWidth="620" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding UsageSummary}" Style="{StaticResource Small}" MaxWidth="620" HorizontalAlignment="Left" Margin="0,8,0,0" />
    <Button Content="Eliminar clave guardada" Command="{Binding DeleteKeyCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding HasKey, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,12,0,0" />
  </StackPanel></ScrollViewer></Expander>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding NeedsKey, Converter={StaticResource Visible}}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,12,24">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="pack://application:,,,/Silen;component/Assets/Brand/silen-bloom.png" Width="42" Height="36" Stretch="Uniform" AutomationProperties.Name="Bloom" Margin="0,0,12,0" /><TextBlock Text="Hablemos de tu PC." Style="{StaticResource DetailSectionTitle}" VerticalAlignment="Center" Margin="0" /></StackPanel>
              <TextBlock Text="Elige tu proveedor y guarda su clave. Tú autorizas cada diagnóstico y confirmas cada cambio." Margin="0,0,0,12" />
              <Label Content="Tu clave de API" Target="{Binding ElementName=BloomPassword}" Padding="0,0,0,5" Foreground="{DynamicResource Text}" />
              <PasswordBox x:Name="BloomPassword" MaxLength="512" MinHeight="42" Padding="10,8" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="Clave del proveedor de IA elegido" />
              <WrapPanel Margin="0,12,0,12"><Button Content="Guardar clave cifrada" Click="SaveBloomKey" IsEnabled="{Binding CanInteract}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button Content="Obtener clave del proveedor" Command="{Binding OpenKeyPageCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8" /></WrapPanel>
              <TextBlock Text="La clave se cifra para tu usuario de Windows. Las cuotas y los posibles cargos dependen del proveedor." Style="{StaticResource Small}" />
              <TextBlock Text="{Binding PrivacySummary}" Style="{StaticResource Small}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Status}" Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasError, Converter={StaticResource Visible}, ConverterParameter=inverse}" />
              <local:SummaryErrorNotice Message="{Binding Status}" Margin="0,12,0,8" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
              <Button Content="Eliminar configuración local" Command="{Binding DeleteKeyCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" Visibility="{Binding HasKey, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12" LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Nueva conversación" Command="{Binding NewConversationCommand}" Style="{StaticResource QuietButton}" FontSize="14" />
              <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Silen;component/Assets/Brand/silen-bloom.png" Width="38" Height="32" Stretch="Uniform" AutomationProperties.Name="Bloom" Margin="0,0,10,0" /><StackPanel><TextBlock Text="{Binding ModelLabel}" Style="{StaticResource Small}" /><TextBlock Text="{Binding StateLabel}" Style="{StaticResource Small}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /></StackPanel></StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="BloomChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0" AutomationProperties.Name="Conversación con Bloom">
              <StackPanel>
                <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,16,0,24" Visibility="{Binding HasMessages, Converter={StaticResource Visible}, ConverterParameter=inverse}"><TextBlock Text="¿Qué quieres revisar?" Style="{StaticResource DetailSectionTitle}" /><TextBlock Text="Pide un diagnóstico o revisa un ajuste. Antes de cualquier cambio podrás confirmar o cancelar." /></StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border BorderThickness="1" BorderBrush="{DynamicResource Line}" Padding="16,12" MaxWidth="620">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Panel}" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,30,12" /><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="{DynamicResource Selection}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="30,0,0,12" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel><TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,3" /><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,8,0,10">
              <StackPanel Visibility="{Binding IsResponding, Converter={StaticResource Visible}}"><ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" /><TextBlock Text="Bloom está trabajando…" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
              <Border BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" Padding="14,10" Visibility="{Binding HasPending, Converter={StaticResource Visible}}">
                <StackPanel><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding PendingDescription}" /></ScrollViewer><WrapPanel Margin="0,10,0,0"><Button Content="Confirmar esta propuesta" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="Cancelar propuesta" Command="{Binding CancelProposalCommand}" /></WrapPanel></StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="3">
              <Grid Visibility="{Binding HasPending, Converter={StaticResource Visible}, ConverterParameter=inverse}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" MinHeight="46" MaxHeight="86" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="Mensaje para Bloom"><TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" /></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="Enviar" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="10,0,0,0" /></Grid>
              <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasError, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><local:SummaryErrorNotice Message="{Binding Status}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" /></StackPanel></ScrollViewer>
              <TextBlock Text="Ctrl+Entrar para enviar · Se envía al proveedor elegido." Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="{Binding HasPending, Converter={StaticResource Visible}, ConverterParameter=inverse}" />
            </StackPanel>
          </Grid>
        </Grid></TabItem>
      </local:PageHost>
      <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0">
        <StackPanel>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="36,12" DataContext="{Binding Restart}" Visibility="{Binding HasChanges, Converter={StaticResource Visible}}"><StackPanel>
  <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
  <WrapPanel><Button Content="Reiniciar PC ahora" Command="{Binding RestartNowCommand}" Margin="0,0,10,0"/><Button Content="Reiniciar al cerrar Silen" Command="{Binding RestartOnCloseCommand}" Margin="0,0,10,0"/><Button Content="Cancelar reinicio" Command="{Binding CancelCommand}" Visibility="{Binding OnClose, Converter={StaticResource Visible}}"/></WrapPanel>
</StackPanel></Border>

          <Grid Visibility="Collapsed"><ProgressBar x:Name="FooterOperationProgress" /><Grid x:Name="FooterOperationStatus" /></Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

    <Grid x:Name="OptimizationDialogLayer" Visibility="{Binding IsOptimizationDialogOpen, Converter={StaticResource Visible}}" Panel.ZIndex="10" Background="{DynamicResource Ink}">
      <Border x:Name="OptimizationDialog" CornerRadius="16" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" Padding="24" Margin="24" MaxWidth="1000" MaxHeight="740" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="{Binding OptimizationDialogTitle}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OptimizationDialogTitle}" Style="{StaticResource DetailSectionTitle}" /><TextBlock Text="Tu selección se aplica solo después de confirmarla." Style="{StaticResource Small}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0"><Button Content="Cancelar operación" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0" /><Button Content="Cerrar" Command="{Binding CloseOptimizationDialogCommand}" /></StackPanel></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel><StackPanel x:Name="ExpertManualOptions" Visibility="{Binding IsManualDialogOpen, Converter={StaticResource Visible}}" IsEnabled="{Binding IsIdle}">
  <Border Visibility="{Binding Tools.HasPendingManual, Converter={StaticResource Visible}}" Style="{StaticResource DetailSection}" Margin="0,0,0,24"><StackPanel>
    <TextBlock Text="Selección manual" Style="{StaticResource DetailSectionTitle}" />
    <TextBlock Text="{Binding Tools.ManualSummary}" Style="{StaticResource Small}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
    <ItemsControl ItemsSource="{Binding Tools.PendingManual}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Small}"/></StackPanel><Button Grid.Column="1" Content="Quitar" Command="{Binding DataContext.Tools.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="12,0,0,0" VerticalAlignment="Top"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

  </StackPanel></Border>
          <local:SummaryErrorNotice Message="{Binding Tools.Status}" Margin="0,0,0,12" Visibility="{Binding Tools.HasActionError, Converter={StaticResource Visible}}" />
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Label Content="Buscar ajuste" /><TextBox Text="{Binding Tools.ManualSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar ajuste manual" /></StackPanel><StackPanel Grid.Column="1"><Label Content="Categoría" /><ComboBox ItemsSource="{Binding Tools.ManualCategoryNames}" SelectedItem="{Binding Tools.ManualCategory}" /></StackPanel></Grid><TextBlock Text="No hay ajustes que coincidan con la búsqueda." Style="{StaticResource Small}" Margin="0,0,0,16" Visibility="{Binding Tools.HasVisibleManualCategories, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><ItemsControl ItemsSource="{Binding Tools.VisibleManualCategories}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource DetailSection}" Margin="0,0,0,24"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource DetailSectionTitle}" /><ItemsControl ItemsSource="{Binding Toggles}" ItemTemplate="{StaticResource OptimizationToggleTemplate}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="Actualiza los ajustes para consultar todas las preferencias y servicios disponibles." Style="{StaticResource Small}" Margin="0,0,0,24" Visibility="{Binding Tools.HasInspection, Converter={StaticResource Visible}, ConverterParameter=inverse}" />
          <Border Style="{StaticResource DetailSection}" Margin="0,0,0,24"><StackPanel x:Name="PowerSection"><TextBlock Text="Plan de energía" Style="{StaticResource DetailSectionTitle}" /><ContentControl Content="{Binding Tools}" ContentTemplate="{StaticResource PowerSchemeTemplate}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailSection}" Margin="0,0,0,24"><StackPanel x:Name="StartupSection"><TextBlock Text="Inicio de tu sesión" Style="{StaticResource DetailSectionTitle}" /><TextBlock Text="Entradas Run del usuario actual (HKCU). Retirar conserva la entrada para restaurarla. Otras fuentes de inicio y la aprobación de Windows se gestionan por separado." Style="{StaticResource Small}" Margin="0,0,0,13" /><DataGrid ItemsSource="{Binding Tools.StartupEntries}" SelectedItem="{Binding Tools.SelectedStartup}" MaxHeight="260" AutomationProperties.Name="Seleccionar aplicación de inicio del usuario"><DataGrid.Columns><DataGridTextColumn Header="Aplicación" Binding="{Binding Entry.Name}" Width="*" /><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="145" MinWidth="145" /><DataGridTextColumn Header="Comando" Binding="{Binding Entry.Command}" Width="2*" /></DataGrid.Columns></DataGrid><TextBlock Text="No hay entradas de inicio disponibles en estas fuentes. Actualiza los ajustes para volver a consultar." Style="{StaticResource Small}" Visibility="{Binding Tools.HasStartup, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><TextBlock Text="{Binding Tools.SelectedStartup.Entry.Command}" Style="{StaticResource Small}" Margin="0,11,0,0" /><Button Content="{Binding Tools.StartupActionLabel}" Command="{Binding Tools.ToggleStartupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Selecciona una aplicación de la lista" ToolTipService.ShowOnDisabled="True" /></StackPanel></Border>
          </StackPanel>
              <ContentControl Content="{Binding PcOptimization}" ContentTemplate="{StaticResource PcOptimizationTemplate}" Visibility="{Binding IsPcDialogOpen, Converter={StaticResource Visible}}" />
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Visibility="{Binding Settings.ShowManual, Converter={StaticResource Visible}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Tools.ManualSummary}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" Content="Aplicar selección manual" Command="{Binding Tools.ApplyManualCommand}" Style="{StaticResource PrimaryButton}" /></Grid></Border>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Visibility="{Binding IsPcDialogOpen, Converter={StaticResource Visible}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding PcOptimization.SelectionSummary}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" Content="Aplicar selección" Command="{Binding PcOptimization.ApplyCommand}" Style="{StaticResource PrimaryButton}" /></Grid></Border>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="BloomActivityPanel" Visibility="{Binding Activity.IsVisible, Converter={StaticResource Visible}}" Panel.ZIndex="30" Width="360" MaxHeight="230" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24,24,150,128" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,14">
      <StackPanel><TextBlock Text="Bloom" Style="{StaticResource Small}" Margin="0,0,0,6" /><TextBlock Text="{Binding Activity.Title}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding Activity.Detail}" Style="{StaticResource Small}" Margin="0,6,0,0" /><WrapPanel Margin="0,10,0,0"><Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding Activity.IsWorking, Converter={StaticResource Visible}}" /><Button Content="Entendido" Command="{Binding DismissActivityCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding Activity.IsWorking, Converter={StaticResource Visible}, ConverterParameter=inverse}" /></WrapPanel></StackPanel>
    </Border>
  </Grid>
</Window>
