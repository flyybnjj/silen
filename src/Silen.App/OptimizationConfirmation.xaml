<Window x:Class="Silen.App.OptimizationConfirmation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Aplicar ajustes" Icon="Assets/Silen.ico" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource Ink}" Padding="32"><StackPanel>
    <Image Source="{DynamicResource SilenLogo}" Width="95" Height="35" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,28" AutomationProperties.Name="silen" />
    <TextBlock x:Name="ReviewHeading" Text="¿Aplicar el perfil de Fortnite?" FontSize="24" LineHeight="32" FontWeight="SemiBold" Margin="0,0,0,12" />
    <TextBlock x:Name="ReviewDescription" Text="Aplicaremos solo los ajustes seleccionados del juego. Puede reducirse su calidad gráfica o cambiar su preferencia GPU." Style="{StaticResource MutedText}" />
    <ScrollViewer x:Name="SelectedStepsPanel" MaxHeight="200" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,12,0,0"><ItemsControl x:Name="SelectedSteps"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock x:Name="ReviewDetail" Text="Se guardarán los originales para restaurarlos en Ajustes. Se conservan la resolución, el límite FPS, el renderizador y los controles. Cierra el juego antes de continuar." Style="{StaticResource Small}" Margin="0,12,0,22" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RejectButton" Content="Ahora no" IsCancel="True" Margin="0,0,10,0" /><Button x:Name="AcceptButton" Content="Confirmar cambios" Click="Accept" Style="{StaticResource PrimaryButton}" /></StackPanel>
  </StackPanel></Border>
</Window>
